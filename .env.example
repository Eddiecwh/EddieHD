# Grix voice settings. Private: never share or commit this file (it's in .gitignore).
# Paste your key after the = sign, with no spaces or quotes around it.

# --- ElevenLabs ---
ELEVENLABS_API_KEY=s
# Voice ID: Callum (built-in, works on the free plan). Library voices need a paid plan.
ELEVENLABS_VOICE_ID=
# eleven_multilingual_v2 = best quality (1 credit per character)
# eleven_flash_v2_5      = faster and cheaper (0.5–1 credit per character)
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- OpenAI (optional; leave empty if you use ElevenLabs) ---
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_VOICE=ballad

# Which one to use if both keys are filled in: elevenlabs or openai
TTS_PROVIDER=elevenlabs
